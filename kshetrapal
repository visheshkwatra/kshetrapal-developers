server {
    server_name kshetrapal.dotdevz.com www.kshetrapal.dotdevz.com;

    client_max_body_size 3M;

    # ── Gzip compression (improves page speed / Core Web Vitals) ──────────
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain text/css text/xml text/javascript
        application/javascript application/json application/xml
        application/rss+xml image/svg+xml;

    # ── Security / SEO headers ─────────────────────────────────────────────
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location ~ ^/.well-known {
        root /home/quickrpe/kshetrapal;
        allow all;
    }

    location = /favicon.ico { access_log off; log_not_found off; }

    # ── Static files with long-term caching ───────────────────────────────
    location /static/ {
        root /home/quickrpe/kshetrapal;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # ── robots.txt served directly from static ────────────────────────────
    location = /robots.txt {
        alias /home/quickrpe/kshetrapal/static/robots.txt;
        access_log off;
        log_not_found off;
    }

    # ── sitemap.xml served by Flask (always fresh from DB) ────────────────
    # (no static alias — falls through to the proxy_pass below)

    location / {
        include proxy_params;
        proxy_pass http://unix:/home/quickrpe/kshetrapal/kshetrapal.sock;

        # Cache headers for HTML pages (short TTL, revalidate)
        add_header Cache-Control "no-cache, must-revalidate" always;
    }
}

# Redirect HTTP → HTTPS
server {
    listen 80;
    server_name kshetrapal.dotdevz.com www.kshetrapal.dotdevz.com;
    return 301 https://$host$request_uri;
}
